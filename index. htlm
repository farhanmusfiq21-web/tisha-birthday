<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Happy Birthday Tisha 🎂</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:Arial,sans-serif;
    background:linear-gradient(135deg,#171717,#3b2035,#151515);
    overflow:hidden;
    color:white;
}

.card{
    width:90%;
    max-width:390px;
    max-height:92vh;
    overflow-y:auto;
    padding:30px 20px;
    text-align:center;
    border-radius:28px;
    background:rgba(255,255,255,.10);
    backdrop-filter:blur(12px);
    box-shadow:0 0 35px rgba(255,105,180,.3);
    position:relative;
    z-index:5;
}

.cat{
    font-size:85px;
    animation:bounce 1.8s infinite;
}

@keyframes bounce{
    0%,100%{
        transform:translateY(0) rotate(-3deg);
    }
    50%{
        transform:translateY(-12px) rotate(3deg);
    }
}

h1{
    font-size:34px;
    margin:10px 0;
    color:#ff9ed2;
    text-shadow:0 0 15px #ff4fa3;
}

.subtitle{
    font-size:15px;
    opacity:.8;
}

.message{
    margin:20px 0;
    font-size:17px;
    line-height:1.6;
}

button{
    border:none;
    padding:13px 22px;
    margin:6px;
    border-radius:30px;
    background:#ff5ca8;
    color:white;
    font-size:15px;
    font-weight:bold;
    cursor:pointer;
    box-shadow:0 0 20px rgba(255,92,168,.6);
}

button:active{
    transform:scale(.95);
}

#surprise{
    display:none;
    margin-top:20px;
    font-size:18px;
    animation:pop .5s ease;
}

#qrBox{
    display:none;
    margin-top:20px;
}

#qrBox img{
    width:180px;
    height:180px;
    padding:8px;
    background:white;
    border-radius:15px;
}

@keyframes pop{
    from{
        transform:scale(.5);
        opacity:0;
    }
    to{
        transform:scale(1);
        opacity:1;
    }
}

.heart{
    position:fixed;
    top:-30px;
    animation:fall linear forwards;
    z-index:1;
    pointer-events:none;
}

@keyframes fall{
    to{
        transform:translateY(110vh) rotate(360deg);
        opacity:0;
    }
}

.footer{
    margin-top:18px;
    font-size:12px;
    opacity:.55;
}
</style>
</head>

<body>

<div class="card">

    <div class="cat">😼</div>

    <h1>
        HAPPY BIRTHDAY<br>
        TISHA 🎂
    </h1>

    <div class="subtitle">
        ⚠️ Birthday Cat has entered the chat!
    </div>

    <div class="message">

        Happy Birthday Tisha! 🥳💗
        <br><br>

        Tui ajke officially aro ek bochor
        boro hoye geli! 😭😂

        <br><br>

        Allah tor life-e onek happiness,
        success ar bhalo bhalo biriyani dik. 🍗😂

        <br><br>

        Ar haan... cake-er ekta piece
        amar jonno reserve rakhbi. 😼🎂

    </div>

    <button onclick="openSurprise()">
        OPEN UR SURPRISE 🎁
    </button>

    <button onclick="showQR()">
        SCAN ME 📱
    </button>

    <div id="surprise">

        😭💗 SURPRISEEEE!!! 💗😭

        <br><br>

        Tisha, tui ekta certified
        <b>janoar but cute janoar</b> 😭🐈

        <br><br>

        Happy Birthday, Bestie! 🥳🎂

    </div>

    <div id="qrBox">

        <p>
            Scan this QR to open Tisha's Birthday 🎂
        </p>

        <img id="qr" alt="Birthday QR Code">

        <br><br>

        <small>
            QR scan করলে online birthday page খুলবে 💗
        </small>

    </div>

    <div class="footer">
        Made with chaos & friendship 😂
    </div>

</div>

<!--
IMPORTANT:
Acode project folder-এর ভিতরে
wanna-be-yours.mp3 নামের audio file রাখতে হবে.
-->

<audio id="birthdayMusic" loop>
    <source src="wanna-be-yours.mp3" type="audio/mpeg">
</audio>

<script>

/* =========================
   WEBSITE LINK FOR QR
   ========================= */

const websiteLink = "YOUR-WEBSITE-LINK-HERE";


/* =========================
   FALLING HEARTS
   ========================= */

function createHeart(){

    const heart = document.createElement("div");

    const hearts = [
        "💗",
        "💖",
        "💕",
        "💘",
        "❤️",
        "🩷",
        "✨"
    ];

    heart.className = "heart";

    heart.innerHTML =
        hearts[Math.floor(Math.random() * hearts.length)];

    heart.style.left =
        Math.random() * 100 + "vw";

    heart.style.animationDuration =
        (3 + Math.random() * 4) + "s";

    heart.style.fontSize =
        (15 + Math.random() * 20) + "px";

    document.body.appendChild(heart);

    setTimeout(function(){
        heart.remove();
    },7000);
}

setInterval(createHeart,350);


/* =========================
   OPEN SURPRISE
   ========================= */

function openSurprise(){

    document.getElementById("surprise")
        .style.display = "block";

    /* Start music after button click */
    const music =
        document.getElementById("birthdayMusic");

    music.play().catch(function(){
        console.log("Music could not autoplay.");
    });

    /* Extra hearts */
    for(let i = 0; i < 30; i++){

        setTimeout(function(){
            createHeart();
        },i * 80);

    }
}


/* =========================
   QR CODE
   ========================= */

function showQR(){

    const qrBox =
        document.getElementById("qrBox");

    qrBox.style.display = "block";

    if(
        websiteLink ===
        "YOUR-WEBSITE-LINK-HERE"
    ){

        alert(
            "আগে websiteLink-এর জায়গায় তোমার online website link বসাও!"
        );

        return;
    }

    const qrURL =
        "https://api.qrserver.com/v1/create-qr-code/"
        + "?size=300x300"
        + "&data="
        + encodeURIComponent(websiteLink);

    document.getElementById("qr").src = qrURL;
}

</script>

</body>
</html>(